// Firebase Storage (hanya bila ingin unggah video guru dari dalam aplikasi).
// Console Firebase > Storage > Aturan. Siapa pun boleh MENONTON; unggah dibatasi tipe & ukuran.
// Catatan: PIN guru hanya dicek di aplikasi. Untuk penguncian sungguhan pakai Firebase Authentication.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /lkpd/{gid}/{file} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
    }
    match /videos/{file} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/(mp4|webm)');
    }
  }
}
